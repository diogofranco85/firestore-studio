{
  "name": "@diogofranco85/firestore-studio",
  "version": "0.1.0",
  "description": "Local data browser/editor for the Firestore emulator",
  "main": "server/start.js",
  "bin": {
    "firestore-studio": "bin/firestore-studio.js"
  },
  "files": [
    "server",
    "public",
    "bin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/diogofranco85/firestore-studio.git"
  },
  "scripts": {
    "start": "node server/start.js",
    "dev": "nodemon --signal SIGHUP server/start.js",
    "test": "node --test"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.6.0"
  },
  "devDependencies": {
    "firebase-tools": "^15.30.0",
    "nodemon": "^3.1.14"
  }
}
